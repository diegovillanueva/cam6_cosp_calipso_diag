   !#######################################################################
 
+  subroutine hist_fld_list_ctd (prefix, names, n)
+    !
+    ! Return the names of all master-list fields whose long_name starts with prefix
+    ! (used by cloud_top_diag to add_default its 'CTD:<GROUP> | ...' fields). Read only.
+    !
+    character(len=*), intent(in) :: prefix
+    character(len=max_fieldname_len), allocatable, intent(out) :: names(:)
+    integer, intent(out) :: n
+
+    type(master_entry), pointer :: listentry
+    integer :: pass
+
+    do pass = 1, 2
+      n = 0
+      listentry => masterlinkedlist
+      do while (associated(listentry))
+        if (index(listentry%field%long_name, prefix) == 1) then
+          n = n + 1
+          if (pass == 2) names(n) = listentry%field%name
+        end if
+        listentry => listentry%next_entry
+      end do
+      if (pass == 1) allocate(names(max(n, 1)))
+    end do
+
+  end subroutine hist_fld_list_ctd
+
